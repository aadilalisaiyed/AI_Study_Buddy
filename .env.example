# PostgreSQL and app authentication. Replace the example local values.
POSTGRES_USER=studybuddy
POSTGRES_PASSWORD=replace-for-local-development
POSTGRES_DB=studybuddy
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://studybuddy:replace-for-local-development@127.0.0.1:5433/studybuddy
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Supabase Storage Free. Keep the bucket private and the key backend-only.
STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=study-documents
MAX_DOCUMENTS_PER_USER=20
TOTAL_DOCUMENT_STORAGE_MB=750

# Google AI Studio project on the Free tier with Cloud Billing disabled.
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_TEMPERATURE=0.2
GEMINI_CHAT_MAX_OUTPUT_TOKENS=1024
GEMINI_CHAT_TIMEOUT_SECONDS=20
GEMINI_RETRY_ATTEMPTS=2
CHAT_TOP_K=6
CHAT_CONTEXT_TOKENS=5000
CHAT_HISTORY_MESSAGES=8
CHAT_MAX_DOCUMENTS=5
CHAT_REQUESTS_PER_MINUTE=3
CHAT_REQUESTS_PER_DAY=20
CHAT_MAX_CONCURRENT=1AQ.Ab8RN6IPkOF3Pf6Mj2PxZT74JEc78SP910KL6JxAP4-TRZCr4Q
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=16

CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_SSL=false

MAX_PDF_SIZE_MB=25
MAX_PDF_PAGES=250
MAX_PDF_TEXT_CHARS=500000
MAX_PDF_CHUNKS=600
PDF_CHUNK_SIZE=1000
PDF_CHUNK_OVERLAP=150
UPLOAD_EXPIRY_HOURS=24
DOCUMENT_MAX_ATTEMPTS=4
DOCUMENT_POLL_SECONDS=2
DOCUMENT_JOB_TIMEOUT_SECONDS=600

# Quiz Studio limits for the shared Free Gemini project
QUIZ_MAX_QUESTIONS=20
QUIZ_MAX_DOCUMENTS=5
QUIZ_DAILY_GENERATIONS=3
QUIZ_CONTEXT_CHARS=11000
QUIZ_MAX_OUTPUT_TOKENS=8192
QUIZ_WEAK_MIN_ANSWERS=3
QUIZ_WEAK_THRESHOLD=65

# Google Calendar and local MCP revisions
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/google/callback
GOOGLE_CALENDAR_SCOPES="https://www.googleapis.com/auth/calendar.events https://www.googleapis.com/auth/calendar.calendarlist.readonly openid email"
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata
CALENDAR_TOKEN_ENCRYPTION_KEY=
PLANNER_FRONTEND_URL=http://127.0.0.1:5173
CALENDAR_REQUESTS_PER_MINUTE=15

# Production requires HTTPS origins and explicit API hosts.
PRODUCTION=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
